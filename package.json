{
  "name": "healthapp",
  "version": "0.0.1",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "dev": "expo start --dev-client",
    "android": "APP_VARIANT=dev expo run:android",
    "android:clean": "APP_VARIANT=dev expo prebuild -p android --clean && APP_VARIANT=dev expo run:android",
    "ios": "expo run:ios",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "build-ios": "APP_ENV=production eas build --clear-cache --profile production --platform ios --local --non-interactive",
    "build-android": "APP_ENV=production eas build --clear-cache --profile production --platform android --local --non-interactive",
    "submit-ios": "eas submit -p ios --profile production",
    "submit-android": "eas submit -p android --profile production"
  },
  "dependencies": {
    "@expo-google-fonts/hanken-grotesk": "^0.4.3",
    "@expo-google-fonts/jetbrains-mono": "^0.4.1",
    "@fugood/react-native-audio-pcm-stream": "^1.1.4",
    "@kingstinct/react-native-healthkit": "^9.0.0",
    "@notifee/react-native": "^9.1.8",
    "@react-navigation/bottom-tabs": "^7.18.14",
    "@react-navigation/native": "^7.3.14",
    "@react-navigation/native-stack": "^7.18.6",
    "buffer": "^6.0.3",
    "expo": "~57.0.9",
    "expo-audio": "~57.0.3",
    "expo-build-properties": "~57.0.10",
    "expo-constants": "~57.0.8",
    "expo-crypto": "^57.0.1",
    "expo-document-picker": "~57.0.0",
    "expo-file-system": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-secure-store": "^57.0.1",
    "expo-sharing": "~57.0.0",
    "expo-splash-screen": "~57.0.5",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "expo-web-browser": "^57.0.2",
    "llama.rn": "^0.12.8",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-health-connect": "^3.4.0",
    "react-native-markdown-display": "^7.0.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "whisper.rn": "^0.7.2",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "babel-preset-expo": "^57.0.5",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.1",
    "jest": "^29.6.3",
    "jest-expo": "~57.0.3",
    "prettier": "^3.6.2",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">= 22.11.0",
    "pnpm": ">= 10"
  },
  "packageManager": "pnpm@10.19.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "llama.rn"
    ]
  }
}
