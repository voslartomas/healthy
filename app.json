{
  "expo": {
    "name": "Healthy",
    "slug": "healthapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "healthapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "cz.healthy",
      "appleTeamId": "3KS75QPJSR"
    },
    "android": {
      "package": "cz.healthy",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1C1710"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "plugins": [
      "expo-sqlite",
      "expo-secure-store",
      "expo-web-browser",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.664943790951-4p7fv3l3vo9bh8s16kn8vohc1k7dr5le"
        }
      ],
      [
        "llama.rn",
        {
          "enableEntitlements": true
        }
      ],
      "./plugins/withRnllamaGradleProps",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Healthy to use the microphone so you can talk to your coach with voice input."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "backgroundColor": "#FAF6EF",
          "dark": {
            "backgroundColor": "#161209"
          }
        }
      ]
    ],
    "extra": {
      "//": "Google Sign-In on Android needs no client ID in app config — the Android OAuth client is bound in Cloud Console via package name (cz.healthy) + SHA-1 signing fingerprint. iOS needs googleIosClientId below (an iOS OAuth client bound to bundle id cz.healthy) passed to GoogleSignin.configure, plus the matching reversed-client-id URL scheme registered via the google-signin plugin's iosUrlScheme above. googleWebClientId is only used for offline-access if ever provided; the legacy googleClientId from the browser PKCE flow is unused.",
      "googleWebClientId": "",
      "googleIosClientId": "664943790951-4p7fv3l3vo9bh8s16kn8vohc1k7dr5le.apps.googleusercontent.com",
      "googleClientId": "664943790951-2tbkvpouvao38e2og6rjj4obnsdgrtt7.apps.googleusercontent.com",
      "eas": {
        "projectId": "42c6722a-64c9-40f3-bb67-96a954d63e67"
      }
    },
    "eas": {
      "projectId": "42c6722a-64c9-40f3-bb67-96a954d63e67"
    },
    "owner": "sport-buddy-dev"
  }
}
