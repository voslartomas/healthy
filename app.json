{
  "expo": {
    "name": "Health Buddy",
    "slug": "healthapp",
    "version": "0.0.1",
    "orientation": "portrait",
    "scheme": "healthapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "cz.healthapp"
    },
    "android": {
      "package": "cz.healthapp"
    },
    "plugins": [
      "expo-sqlite",
      "expo-secure-store",
      "expo-web-browser",
      "@react-native-google-signin/google-signin",
      [
        "llama.rn",
        {
          "enableEntitlements": true
        }
      ],
      "./plugins/withRnllamaGradleProps",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "backgroundColor": "#FAF6EF",
          "dark": { "backgroundColor": "#161209" }
        }
      ]
    ],
    "extra": {
      "//": "Google Sign-In on Android needs no client ID in app config — the Android OAuth client is bound in Cloud Console via package name (cz.healthapp) + SHA-1 signing fingerprint. googleWebClientId below is only used for iOS/offline-access if ever provided; the legacy googleClientId from the browser PKCE flow is unused.",
      "googleWebClientId": "",
      "googleClientId": "664943790951-2tbkvpouvao38e2og6rjj4obnsdgrtt7.apps.googleusercontent.com"
    }
  }
}
