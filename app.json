{
  "expo": {
    "name": "HealthApp",
    "slug": "healthapp",
    "version": "0.0.1",
    "orientation": "portrait",
    "scheme": "healthapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.healthapp"
    },
    "android": {
      "package": "com.healthapp"
    },
    "plugins": [
      "expo-sqlite",
      "expo-secure-store",
      "expo-web-browser"
    ],
    "extra": {
      "//": "Google Health cloud API OAuth client ID (iOS/Android OAuth 2.0 client, no secret — PKCE). Provide the real value here or via app config; empty disables the live cloud read and the app renders sample data.",
      "googleClientId": ""
    }
  }
}
